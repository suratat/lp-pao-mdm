# T6: ตัวอย่างค่า env สำหรับ docker-compose.staging.yml - คัดลอกเป็น infra/.env.staging แล้วแก้ค่าจริงเอง
# (infra/.env.staging ถูก .gitignore ไว้แล้ว ห้าม commit ค่าจริงเด็ดขาด ตาม CLAUDE.md กฎข้อ 7)
# คำสั่งรัน: docker compose --env-file infra/.env.staging -f infra/docker-compose.staging.yml up -d

# --- Postgres (mdm_migrator = superuser ของ container นี้, ตั้งตอน initdb ครั้งแรกเท่านั้น) ---
POSTGRES_USER=mdm_migrator
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mdm

# --- รหัสผ่านของ LOGIN role จริงที่ api/worker ใช้เชื่อมต่อ (bootstrap-roles.sql สร้าง/อัปเดตให้) ---
MDM_API_DB_PASSWORD=CHANGE_ME
MDM_WORKER_DB_PASSWORD=CHANGE_ME
KEYCLOAK_SVC_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# KC_HOSTNAME ของ docker-compose.keycloak.yml (Keycloak v26 hostname v2 - ต้องเป็น URL เต็มมี scheme,
# ไม่ใช่แค่ hostname/IP เฉยๆ แบบเดิม) - ตั้งเป็น URL สาธารณะจริงที่ผ่าน Cloudflare Tunnel (VM WireGuard
# 192.168.0.5 เป็น production host ถาวรแล้ว) ไม่ใช้คู่กับ KC_HOSTNAME_PORT อีกต่อไป (v1 option เดิม ตั้งคู่
# กับ URL เต็มแล้วชนกัน ทำให้ Admin Console โหลดไม่สำเร็จ)
KEYCLOAK_PUBLIC_URL=https://iam.lp-pao.go.th
# พอร์ตที่ container Keycloak นี้ฟัง/map ออก host (Cloudflare Tunnel ชี้เข้ามาที่พอร์ตนี้บน VM) - คนละเรื่อง
# กับ KEYCLOAK_PUBLIC_URL ด้านบน (นั่นคือ URL สาธารณะที่ Keycloak ใช้ generate ลิงก์ของตัวเอง)
KEYCLOAK_PUBLIC_PORT=8081

# --- JWT / Keycloak (realm lp-pao ของจริงที่มีอยู่แล้ว - ไม่ใช่ keycloak ใน docker-compose.smoketest.yml) ---
JWT_JWKS_URI=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/certs
JWT_ISSUER=https://iam.lp-pao.go.th/realms/lp-pao
JWT_AUDIENCE=mdm-api

# --- check.lp-pao.go.th (worker เรียกตอน revoke session) ---
CHECK_BASE_URL=https://check.lp-pao.go.th
CHECK_SHARED_SECRET=CHANGE_ME

# --- Keycloak admin service account (mdm-worker client ตามภาคผนวก ก ข้อ 3: realm-management
# view-users/manage-users - ใช้ disable/logout ผู้ใช้ตอน deactivate) ---
KEYCLOAK_BASE_URL=https://iam.lp-pao.go.th
KEYCLOAK_REALM=lp-pao
KEYCLOAK_ADMIN_CLIENT_ID=mdm-worker
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# --- reverify scheduling (seq-02) ---
REVERIFY_MAX_AGE_DAYS=180
REVERIFY_ON_CARD_EXPIRY_DAYS=60
GRACE_DAYS=30

# --- webhook SSRF allow-list (§2.3, T5) ---
WEBHOOK_ALLOWED_HOSTS=eoffice.lp-pao.go.th,telemed.lp-pao.go.th

# --- public base URL ที่ประกอบ photoUrl ใน response (personPresenter.js) ---
PUBLIC_API_BASE_URL=https://mdm.lp-pao.go.th/api/v1

# --- MDM Portal (T9, self-service) - service portal ใน docker-compose.staging.yml ---
# พอร์ตที่ portal ฟัง (container) และพอร์ตที่ map ออก host พร้อมกัน (ดู docker-compose.staging.yml)
PORTAL_PORT=3100

# secret เซ็น X-Acting-Person assertion (HS256, อายุ ≤30 วิ) - ต้องเป็นค่าเดียวกับที่ตั้งให้ api1/api2
# ด้านบนเป๊ะ ๆ (§0.3 ทางเลือก B) คนละตัวกับ PORTAL_SESSION_SECRET ด้านล่าง
PORTAL_ACTING_ASSERTION_SECRET=CHANGE_ME

# secret สำหรับเซ็น session cookie ของ Portal เอง (คนละตัวกับ PORTAL_ACTING_ASSERTION_SECRET)
PORTAL_SESSION_SECRET=CHANGE_ME

# Keycloak client credentials ของ Portal เอง (client "mdm-portal", scope personnel:self - คนละ client กับ
# mdm-worker ที่ใช้ KEYCLOAK_ADMIN_CLIENT_ID ด้านบน) realm lp-pao ของจริง ไม่ใช่ keycloak ใน
# docker-compose.smoketest.yml
#
# ตั้งใจใช้ชื่อ PORTAL_CLIENT_ID/PORTAL_CLIENT_SECRET (ไม่ใช่ KEYCLOAK_CLIENT_ID/SECRET แบบ generic เหมือน
# เดิม) - พบว่าชื่อ generic เดิมทำให้ตั้งค่าจริงใน .env.staging สลับ client กันระหว่าง portal/worker (ใส่ค่า
# ของ mdm-worker ลงช่อง portal ไปโดยไม่รู้ตัว เพราะชื่อตัวแปรคล้ายกันเกินไปเมื่อกรอกในไฟล์เดียวกัน)
KEYCLOAK_TOKEN_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/token
PORTAL_CLIENT_ID=mdm-portal
PORTAL_CLIENT_SECRET=CHANGE_ME

# --- ล็อกอินจริงผ่าน check.lp-pao.go.th (§0.5, portal/README.md) - CHECK_BASE_URL ใช้ค่าเดียวกับของ
# worker ด้านบน CHECK_CLIENT_ID/CHECK_CLIENT_SECRET ต้องลงทะเบียน Portal ไว้ใน ALLOWED_APPS ของ check ก่อน
# (งาน ops แยก) PORTAL_AUTH_CALLBACK_URL ต้อง exact-match กับ redirect_uri ที่ลงทะเบียนไว้เป๊ะ ๆ ---
CHECK_CLIENT_ID=CHANGE_ME
CHECK_CLIENT_SECRET=CHANGE_ME
PORTAL_AUTH_CALLBACK_URL=https://portal.lp-pao.go.th/auth/callback

# --- HR Console (T9 รอบ 2) - service hr-console ใน docker-compose.staging.yml ---
# พอร์ตที่ hr-console ฟัง (container) และพอร์ตที่ map ออก host พร้อมกัน
HR_CONSOLE_PORT=3200

# authorization endpoint ของ Keycloak (realm lp-pao ของจริง) - hr-console ใช้ authorization code flow
# แบบมีผู้ใช้ล็อกอินจริง (ต่างจาก mdm-portal/mdm-worker ที่เป็น service account ล้วน) จึงต้องมีตัวนี้
# เพิ่มจากที่ portal เคยตั้งไว้ (portal ไม่มี endpoint นี้เพราะไม่เคย redirect ผู้ใช้ไป Keycloak ตรง ๆ)
KEYCLOAK_AUTHORIZATION_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/auth
# ปุ่ม "ออกจากระบบ" ของ hr-console เรียก endpoint นี้ด้วย (ไม่บังคับ - ไม่ตั้งจะแค่ล้าง session cookie เอง)
KEYCLOAK_LOGOUT_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/logout

# client "hr-console" (confidential, standardFlowEnabled=true) ใน Keycloak realm lp-pao ของจริง -
# **ต้องมี default client scope personnel:read:basic เพิ่มจากที่ตกลงไว้ตอนแรก (personnel:provision,
# personnel:write:employment, personnel:import) ด้วย มิฉะนั้นหน้า reverify list จะเห็นแค่ personId เปล่า ๆ
# ไม่มีชื่อ/สังกัดให้ระบุตัวคน - ดู hr-console/README.md หัวข้อ "ทำไมต้องมี personnel:read:basic"**
HR_CONSOLE_CLIENT_ID=hr-console
HR_CONSOLE_CLIENT_SECRET=CHANGE_ME
# ต้อง exact-match กับ redirect_uri ที่ลงทะเบียนไว้ใน Keycloak client hr-console เป๊ะ ๆ
HR_CONSOLE_CALLBACK_URL=https://hr.lp-pao.go.th/auth/callback
HR_CONSOLE_SCOPES=openid personnel:provision personnel:write:employment personnel:import personnel:read:basic personnel:manage:reference

# ไม่ใช้แล้ว (T10-fix): เดิมใช้เข้ารหัส session cookie JWE ที่พก access/refresh token ซึ่งโตเกิน 4096 ไบต์ ตอนนี้ session
# อยู่ในหน่วยความจำของ hr-console (cookie เก็บแค่ session id) - ปล่อยไว้หรือลบทิ้งได้ ไม่มีผล
HR_CONSOLE_SESSION_SECRET=CHANGE_ME

# --- DPO Console (T9 รอบ 3) - service dpo-console ใน docker-compose.staging.yml ---
# พอร์ตที่ dpo-console ฟัง (container) และพอร์ตที่ map ออก host พร้อมกัน
DPO_CONSOLE_PORT=3300

# client "dpo-console" (confidential, standardFlowEnabled=true) ใน Keycloak realm lp-pao ของจริง -
# scope audit:read/events:read/mdm-api-audience/roles ตั้งเป็น Default ให้ครบแล้ว (ต่างจาก hr-console ที่
# ต้องขอ personnel:read:basic เพิ่มทีหลัง - ดู dpo-console/README.md)
DPO_CONSOLE_CLIENT_ID=dpo-console
DPO_CONSOLE_CLIENT_SECRET=CHANGE_ME
# ต้อง exact-match กับ redirect_uri ที่ลงทะเบียนไว้ใน Keycloak client dpo-console เป๊ะ ๆ
DPO_CONSOLE_CALLBACK_URL=https://dpo.lp-pao.go.th/auth/callback
DPO_CONSOLE_SCOPES=openid audit:read events:read

# ไม่ใช้แล้ว (T10-fix): เหตุผลเดียวกับ HR_CONSOLE_SESSION_SECRET ด้านบน - ปล่อยไว้หรือลบทิ้งได้ ไม่มีผล
DPO_CONSOLE_SESSION_SECRET=CHANGE_ME
