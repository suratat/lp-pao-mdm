# ค่าจริงของ staging/production ต้องมาจาก Docker secrets / env ของเครื่องจริงเท่านั้น (ห้าม commit ค่าจริง)
PORT=3100
NODE_ENV=development

MDM_API_BASE_URL=https://mdm.lp-pao.go.th

# PORTAL_CLIENT_ID/PORTAL_CLIENT_SECRET = client credentials ของ Portal เอง (client "mdm-portal") -
# ตั้งใจแยกชื่อจาก KEYCLOAK_ADMIN_CLIENT_ID/SECRET ของ worker (client "mdm-worker") ให้ชัดเจน หลังพบว่า
# ชื่อ generic เดิม (KEYCLOAK_CLIENT_ID) เคยถูกตั้งค่าสลับ client กันระหว่าง portal/worker ใน .env.staging จริง
KEYCLOAK_TOKEN_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/token
PORTAL_CLIENT_ID=mdm-portal
PORTAL_CLIENT_SECRET=CHANGE_ME

# ต้องเป็นค่าเดียวกับ PORTAL_ACTING_ASSERTION_SECRET ของ api/ (§0.3 ทางเลือก B)
PORTAL_ACTING_ASSERTION_SECRET=

# secret สำหรับเซ็น session cookie ของ Portal เอง (คนละตัวกับ PORTAL_ACTING_ASSERTION_SECRET)
PORTAL_SESSION_SECRET=

# ล็อกอินจริงผ่าน check.lp-pao.go.th (§0.5) - ต้องตั้งทั้ง 4 ตัวนี้ให้ครบใน production
# ไม่ตั้งเลยสักตัว = fallback ไปใช้ dev-login stub (ปิดอัตโนมัติเมื่อ NODE_ENV=production)
# CHECK_CLIENT_ID/CHECK_CLIENT_SECRET ต้องลงทะเบียน Portal ไว้ใน ALLOWED_APPS ของ check ก่อน (งาน ops แยก)
CHECK_BASE_URL=https://check.lp-pao.go.th
CHECK_CLIENT_ID=
CHECK_CLIENT_SECRET=
# ต้อง exact-match กับ redirect_uri ที่ลงทะเบียนไว้ใน check เป๊ะ ๆ (รวม scheme/host/path)
PORTAL_AUTH_CALLBACK_URL=https://portal.lp-pao.go.th/auth/callback
