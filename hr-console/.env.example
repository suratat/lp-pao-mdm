# ค่าจริงของ staging/production ต้องมาจาก Docker secrets / env ของเครื่องจริงเท่านั้น (ห้าม commit ค่าจริง)
PORT=3200
NODE_ENV=development

MDM_API_BASE_URL=https://mdm.lp-pao.go.th

# --- Keycloak (realm lp-pao ของจริง) - authorization code flow ด้วย client "hr-console" ---
# ต้องเป็น client แบบ standardFlowEnabled=true (confidential, มี client secret) ไม่ใช่ service account
# แบบ mdm-portal/mdm-worker เพราะ HR ต้องล็อกอินเป็นผู้ใช้จริงเพื่อให้ตรวจ realm role hr_officer ได้
KEYCLOAK_AUTHORIZATION_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/token
KEYCLOAK_JWKS_URI=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://iam.lp-pao.go.th/realms/lp-pao
# ปุ่ม "ออกจากระบบ" เรียก endpoint นี้ด้วย (ไม่บังคับ - ถ้าไม่ตั้งจะแค่ล้าง session cookie ของ HR Console เอง)
KEYCLOAK_LOGOUT_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/logout

HR_CONSOLE_CLIENT_ID=hr-console
HR_CONSOLE_CLIENT_SECRET=CHANGE_ME
# ต้อง exact-match กับ redirect_uri ที่ลงทะเบียนไว้ใน Keycloak client hr-console เป๊ะ ๆ
HR_CONSOLE_CALLBACK_URL=https://hr.lp-pao.go.th/auth/callback

# scope ที่ขอตอน authorization code (ต้องเป็น default/optional client scope ของ client hr-console ใน
# Keycloak ทุกตัว มิฉะนั้น Keycloak จะไม่ออก scope นั้นให้) - รวม personnel:read:basic เพื่อให้หน้า
# reverify list เห็นชื่อ/สังกัด/verificationStatus ได้ (ดู hr-console/README.md หัวข้อ "ทำไมต้องมี
# personnel:read:basic")
HR_CONSOLE_SCOPES=openid personnel:provision personnel:write:employment personnel:import personnel:read:basic personnel:manage:reference

# ไม่ใช้แล้ว (T10-fix): เดิมใช้เข้ารหัส session cookie JWE ที่พก token ซึ่งโตเกิน 4096 ไบต์ ตอนนี้ session อยู่ใน
# หน่วยความจำของ process (cookie เก็บแค่ session id) - ไม่ต้องตั้งค่านี้
#HR_CONSOLE_SESSION_SECRET=
