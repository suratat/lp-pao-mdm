# ค่าจริงของ staging/production ต้องมาจาก Docker secrets / env ของเครื่องจริงเท่านั้น (ห้าม commit ค่าจริง)
PORT=3300
NODE_ENV=development

MDM_API_BASE_URL=https://mdm.lp-pao.go.th

# --- Keycloak (realm lp-pao ของจริง) - authorization code flow ด้วย client "dpo-console" ---
# ต้องเป็น client แบบ standardFlowEnabled=true (confidential, มี client secret) เหมือน hr-console
# เพราะเจ้าหน้าที่ต้องล็อกอินเป็นผู้ใช้จริงเพื่อให้ตรวจ realm role dpo/auditor ได้
KEYCLOAK_AUTHORIZATION_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/token
KEYCLOAK_JWKS_URI=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://iam.lp-pao.go.th/realms/lp-pao
# ปุ่ม "ออกจากระบบ" เรียก endpoint นี้ด้วย (ไม่บังคับ - ถ้าไม่ตั้งจะแค่ล้าง session cookie ของ DPO Console เอง)
KEYCLOAK_LOGOUT_URL=https://iam.lp-pao.go.th/realms/lp-pao/protocol/openid-connect/logout

DPO_CONSOLE_CLIENT_ID=dpo-console
DPO_CONSOLE_CLIENT_SECRET=CHANGE_ME
# ต้อง exact-match กับ redirect_uri ที่ลงทะเบียนไว้ใน Keycloak client dpo-console เป๊ะ ๆ
DPO_CONSOLE_CALLBACK_URL=https://dpo.lp-pao.go.th/auth/callback

# scope ที่ขอตอน authorization code - audit:read/events:read/mdm-api-audience/roles เป็น Default client
# scope ของ dpo-console อยู่แล้วใน Keycloak (ได้มาโดยไม่ต้องขอก็ได้) แต่ระบุไว้ตรง ๆ เพื่อความชัดเจน
DPO_CONSOLE_SCOPES=openid audit:read events:read

# ไม่ใช้แล้ว (T10-fix): เดิมใช้เข้ารหัส session cookie JWE ที่พก token ซึ่งโตเกิน 4096 ไบต์ ตอนนี้ session อยู่ใน
# หน่วยความจำของ process (cookie เก็บแค่ session id) - ไม่ต้องตั้งค่านี้
#DPO_CONSOLE_SESSION_SECRET=
